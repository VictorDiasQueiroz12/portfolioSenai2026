---
import Layout from '../../layouts/Layout.astro';
import projects from '../../data/projects.json';
import { url, optimized } from '../../lib/paths';
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}
const { project: p } = Astro.props;
---

<Layout title={p.title + ' — Victor Queiroz'} description={p.description}>
  <main id="main" class="container detail-page">
    <a class="text-link" href={url('') + '#projetos'}>
      ← Todos os projetos
    </a>
    <header class="detail-header">
      <p class="eyebrow">
        {p.category} / {p.trimester}º TRIMESTRE / 2026
      </p>
      <h1>{p.title}</h1>
      <p class="detail-subtitle">{p.subtitle}</p>
      <ul class="tags">
        {p.tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    </header>
    <div class="detail-grid">
      <div class="detail-content">
        {p.fields.map((f) => (
          <section>
            <h2>{f.label}</h2>
            <p>{f.text}</p>
          </section>
        ))}
        {p.code.map((c, i) => (
          <section>
            <h2>Código Arduino {p.code.length > 1 ? i + 1 : ''}</h2>
            <pre tabindex="0" aria-label="Código Arduino"><code>{c}</code></pre>
          </section>
        ))}
      </div>
      <aside class="detail-assets" aria-label="Materiais do projeto">
        {p.images.map((img, i) => (
          <figure>
            <a href={url(img)} target="_blank" rel="noopener noreferrer">
              <img
                src={optimized(img)}
                alt={p.title + ' — registro ' + (i + 1)}
                width="960"
                height="640"
                loading="lazy"
              />
            </a>
            <figcaption>Registro {i + 1} · Abrir imagem original ↗</figcaption>
          </figure>
        ))}
        {p.links.length > 0 && (
          <div class="resource-links">
            <h2>Explore o projeto</h2>
            {p.links.map((l) => (
              <a
                class="button secondary"
                href={l.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {l.label}
              </a>
            ))}
          </div>
        )}
        {p.videos.map((video, i) => (
          <div class="video-resource">
            <button
              class="video-load button secondary"
              data-video={video}
              data-title={p.title + ' — vídeo ' + (i + 1)}
            >
              ▶ Carregar vídeo {i + 1}
            </button>
            <p class="video-note">Ao carregar, você se conecta ao YouTube.</p>
            <a href={video} target="_blank" rel="noopener noreferrer">
              Assistir no YouTube ↗
            </a>
          </div>
        ))}
      </aside>
    </div>
    <div class="detail-end">
      <a class="button primary" href={url('') + '#projetos'}>
        Continuar explorando ↗
      </a>
    </div>
  </main>
</Layout>
