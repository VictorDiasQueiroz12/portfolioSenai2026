---
import '../styles/global.css';
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import { url } from '../lib/paths';
import SocialLinks from '../components/SocialLinks.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Victor Dias Queiroz — Desenvolvedor de Sistemas',
  description = 'Desenvolvedor em formação no SESI SENAI, em Florianópolis. Conheça meus projetos de desenvolvimento web, Arduino e experiências de aprendizagem.',
} = Astro.props;
const canonicalPath = Astro.url.pathname.replace(/\.html\/$/, '.html');
const canonical = new URL(canonicalPath, Astro.site);
const isNotFound = /\/404(?:\.html|\/)?$/.test(canonicalPath);
const home = Astro.url.pathname === url('');
const sections = [
  ['inicio', 'Início'],
  ['sobre', 'Sobre'],
  ['habilidades', 'Habilidades'],
  ['projetos', 'Projetos'],
  ['formacao', 'Formação'],
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f7f2" />
    <title>{title}</title>
    {!isNotFound && <link rel="canonical" href={canonical} />}
    {isNotFound && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL(url('social-card.png'), Astro.site)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          t === 'dark' || t === 'light'
            ? t
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Pular para o conteúdo
    </a>
    <header class="site-header">
      <div class="nav-inner">
        <a class="brand" href={url('')} aria-label="Victor Queiroz, início">
          vq<span>.</span>
        </a>
        <nav id="navigation" aria-label="Principal">
          <ul>
            {sections.map(([id, label]) => (
              <li>
                <a
                  href={home ? '#' + id : url('') + '#' + id}
                  data-section={id}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="nav-tools">
          <button
            id="theme-toggle"
            class="icon-button"
            aria-label="Alternar tema"
            title="Alternar tema"
          >
            ◐
          </button>
          <button
            id="menu-toggle"
            class="icon-button menu-toggle"
            aria-controls="navigation"
            aria-expanded="false"
            aria-label="Abrir menu"
          >
            ☰
          </button>
        </div>
      </div>
    </header>
    <slot />
    <footer class="site-footer container">
      <SocialLinks />
      <a class="brand" href={url('')}>
        vq<span>.</span>
      </a>
      <p>
        Feito com curiosidade, código e propósito.
        <br />
        <small>© {new Date().getFullYear()} Victor Dias Queiroz</small>
      </p>
      <a href={url('') + '#inicio'}>Voltar ao início ↑</a>
    </footer>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
